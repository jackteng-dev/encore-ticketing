# 私有設定另存 work/runtime.env；不提交或在VITE_*內放秘密。
COMPOSE_PROJECT_NAME=ticket-demo
TICKET_PG_PORT=25432
TICKET_DB_USER=ticket_demo
TICKET_DB_PASSWORD=
TICKET_DB_URL=jdbc:postgresql://127.0.0.1:25432/ticket_demo
TICKET_PORT=19110
TICKET_COOKIE_SECURE=true
TICKET_DEMO_BOOTSTRAP=false
TICKET_STAFF_USERNAME=manager
TICKET_STAFF_PASSWORD=
TICKET_ORDERS_ENABLED=false
TICKET_EXPIRY_ENABLED=true
TICKET_EXPIRY_DELAY_MS=30000
TICKET_MOCK_PAYMENTS_ENABLED=false
TICKET_ADMISSION_ENABLED=false
TICKET_REDIS_HOST=127.0.0.1
TICKET_REDIS_PORT=26379
TICKET_REDIS_PASSWORD=
TICKET_REDIS_NAMESPACE=encore-demo-local
TICKET_REDIS_CONFIG=../work/redis.conf
TICKET_ADMISSION_ACTIVE=2
TICKET_ADMISSION_QUEUE=100
TICKET_ADMISSION_PERMIT_SECONDS=30
TICKET_ADMISSION_IDLE_SECONDS=20
TICKET_ADMISSION_WAIT_SECONDS=300
TICKET_ADMISSION_JOIN_RATE=30
TICKET_ADMISSION_PLACE_RATE=5
TICKET_PURCHASES_ENABLED=false
TICKET_PURCHASE_DEADLINE_SECONDS=60
# Optional infra/compose.mq.yml; init_mq.py appends private credentials without replacement.
TICKET_MQ_HOST=127.0.0.1
TICKET_MQ_PORT=25672
TICKET_MQ_USER=ticket_demo
TICKET_MQ_PASSWORD=
TICKET_MQ_VHOST=/ticket-demo
TICKET_MQ_NAMESPACE=encore-demo-local
TICKET_DELIVERY_ENABLED=false
TICKET_PUBLISHER_ENABLED=false
TICKET_CONSUMER_ENABLED=false
TICKET_MQ_CONFIRM_TIMEOUT_MS=2000
TICKET_OUTBOX_LEASE_SECONDS=15
TICKET_OUTBOX_POLL_MS=500
TICKET_MQ_RETRY_DELAY_MS=5000
TICKET_MQ_MAX_RETRIES=3
TICKET_MQ_PREFETCH=4
# Customer pre-debit is opt-in and also requires orders/purchases/delivery/
# publisher/recovery/expiry enabled plus internally prepared READY projections.
TICKET_PREDEBIT_ENABLED=false
TICKET_STOCK_MAINTENANCE_ENABLED=false
TICKET_STOCK_RECOVERY_ENABLED=false
TICKET_STOCK_RECOVERY_LEASE_SECONDS=30
TICKET_STOCK_RECOVERY_BATCH=10
TICKET_STOCK_RECOVERY_POLL_MS=1000
TICKET_STOCK_REVIEW_ENABLED=false
